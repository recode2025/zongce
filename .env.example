# ===== 数据库（生产/Compose：MySQL；本地开发可将 DATABASE_URL 留空使用 SQLite）=====
DATABASE_URL=mysql://zc:ChangeMe_Zc2026@localhost:3306/zongce?charset=utf8mb4
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ===== Redis（可选；留空则退化为进程内缓存+内联任务，仅限本地开发）=====
REDIS_URL=redis://localhost:6379/0

# ===== 认证 =====
# JWT 访问令牌密钥（openssl rand -hex 32 生成）
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SEC=900

# 身份证等敏感字段加密密钥（32 字节 hex）
AES_KEY_HEX=

# 初始超管密码（首次 seed 使用）
INITIAL_ADMIN_PASSWORD=

# 学生初始密码模式：LITERAL:固定串 | LAST6:学号后6位
STUDENT_INIT_PWD_MODE=LAST6

# 登录页密语口令默认值（后台 系统管理→安全设置 可改，存 SysConfig 表）
LOGIN_PASSPHRASE=DUFL1964

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100
# zip 沙箱限额
ZIP_MAX_ENTRIES=500
ZIP_MAX_TOTAL_MB=500
ZIP_MAX_ENTRY_MB=20
ZIP_MAX_RATIO=100

# ===== CORS（生产填前端域名，多个用逗号分隔）=====
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ===== 服务 =====
PORT=3000
# 仅当后端只能通过可信反向代理访问且代理覆写 X-Forwarded-For 时启用。
TRUST_PROXY=false

# ===== AI 申报草稿（可选，仅服务端使用；密钥不可放到前端）=====
# 学生输入的事实和所选规则字段会发送给 DeepSeek，请先确认学校允许使用。
DEEPSEEK_API_KEY=
# 填写账户可用的模型 ID；默认值需与服务商实际提供的模型一致
DEEPSEEK_MODEL=deepseek-flash
# 北京时间自然日计数；发起上游请求即消耗次数，包括超时或上游错误
AI_DAILY_USER_LIMIT=10
AI_DAILY_GLOBAL_LIMIT=1000
# AI 同时处理请求数上限（全平台）
AI_CONCURRENT_LIMIT=5

# ===== 阿里云 CDN（全站加速 DCDN）=====
# 回源校验 token：openssl rand -hex 16 生成，同时在控制台「域名管理 → 回源配置 →
# 自定义 HTTP 回源头」添加 X-Origin-Token 为同值；留空 = 不校验（未套 CDN 直连部署时留空）
ORIGIN_TOKEN=
# 套 CDN 后 CORS 填加速域名（同域部署前后端则无需额外配置），如：
# CORS_ORIGIN=https://zc.example.edu.cn
# CAS 浏览器回调仅允许 CORS_ORIGIN 中明确配置的前端来源。
