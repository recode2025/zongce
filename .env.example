# ===== 数据库（生产/Compose：MySQL；本地开发可将 DATABASE_URL 留空使用 SQLite）=====
DATABASE_URL=mysql://zc:ChangeMe_Zc2026@localhost:3306/zongce?charset=utf8mb4

# ===== Redis（可选；留空则退化为进程内缓存+内联任务，仅限本地开发）=====
REDIS_URL=redis://localhost:6379/0

# ===== 认证 =====
# JWT 访问令牌密钥（openssl rand -hex 32 生成）
JWT_ACCESS_SECRET=ChangeMe_9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c
JWT_ACCESS_TTL_SEC=900

# 身份证等敏感字段加密密钥（32 字节 hex）
AES_KEY_HEX=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# 初始超管密码（首次 seed 使用）
INITIAL_ADMIN_PASSWORD=Admin@Zc2026

# 学生初始密码模式：LITERAL:固定串 | LAST6:学号后6位
STUDENT_INIT_PWD_MODE=LAST6

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100
# zip 沙箱限额
ZIP_MAX_ENTRIES=500
ZIP_MAX_TOTAL_MB=500
ZIP_MAX_ENTRY_MB=20
ZIP_MAX_RATIO=100

# ===== CORS（生产填前端域名，多个用逗号分隔）=====
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ===== 服务 =====
PORT=3000

# ===== 阿里云 CDN（全站加速 DCDN）=====
# 回源校验 token：openssl rand -hex 16 生成，同时在控制台「域名管理 → 回源配置 →
# 自定义 HTTP 回源头」添加 X-Origin-Token 为同值；留空 = 不校验（未套 CDN 直连部署时留空）
ORIGIN_TOKEN=
# 套 CDN 后 CORS 填加速域名（同域部署前后端则无需额外配置），如：
# CORS_ORIGIN=https://zc.example.edu.cn
# 注：数字大外 CAS 登录为后端代理式（POST /auth/cas-login），不经浏览器回调，与 CDN 无关
