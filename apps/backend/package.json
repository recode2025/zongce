{
  "name": "@zc/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:image": "prisma generate && tsc -p tsconfig.json",
    "dev": "pnpm db:generate && tsc -p tsconfig.json --watch --preserveWatchOutput & node --enable-source-maps --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:seed": "tsc -p prisma/tsconfig.json && node prisma/seed.js",
    "db:local": "node scripts/make-sqlite-schema.mjs && prisma db push --schema prisma/sqlite.schema.prisma --skip-generate --accept-data-loss && prisma generate --schema prisma/sqlite.schema.prisma"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "@prisma/client": "^6.19.0",
    "@zc/shared": "workspace:*",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/yauzl": "^2.10.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
